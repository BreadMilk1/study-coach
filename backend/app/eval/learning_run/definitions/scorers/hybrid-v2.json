{
  "schema_version": "scorer-bundle-v1",
  "scorer_id": "hybrid",
  "version": "hybrid-v2",
  "parser_version": "json-rubric-v2",
  "rubric": {
    "scale": {
      "min": 1,
      "max": 5
    },
    "anchors": {
      "1": "Absent, contradicted, wholly unsupported, or a required refusal that is missing.",
      "2": "Mostly unsupported, substantially incomplete, or an expected refusal that still leaks an answer.",
      "3": "Materially incomplete, only partly supported, or a refusal that is vague about the missing evidence.",
      "4": "Meets the bar: every atomized claim is evidence-supported, or the refusal names the missing evidence without extra claims.",
      "5": "Complete, precise, and strictly atomized against allowed evidence; expected refusals cite the empty-evidence boundary."
    }
  },
  "required_dimensions_by_case_type": {
    "answerable": [
      "groundedness",
      "citation_entailment",
      "coverage"
    ],
    "multi_evidence": [
      "groundedness",
      "citation_entailment",
      "coverage"
    ],
    "expected_refusal": [
      "refusal_appropriateness",
      "unsupported_claims"
    ]
  },
  "verdict_policy": {
    "required_minimum": 4,
    "critical_findings_fail": true,
    "scorer_failure_verdict": "inconclusive",
    "fallback_verdict": "never_pass",
    "average_cannot_cover_dimension_below": 4
  },
  "model_config": {
    "provider": "ollama",
    "model": "llama3.2",
    "temperature": 0,
    "max_tokens": 512
  },
  "components": [
